cabal-version: 3.0
name: free-agent
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: control
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/free-agent#readme
bug-reports: https://github.com/tonyday567/free-agent/issues
synopsis: Free syntax above circuits-agent (Agent / Shard seats)
description:
  Free constructions above circuits-agent: FreeAgent category and Layer folds,
  inspectable Pipeline stages (Category, route/forName helpers), Host and
  processHost shards (multi-post emit), and FreeSeat composition into
  Shard (StateT [Post] IO) via composeEnds. Package role ABOVE — depends on
  circuits-agent; does not replace Post/Agent/Shard.

build-type: Simple
tested-with:
  ghc ==9.14.1

extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/free-agent

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

common ghc2024-stanza
  default-language: GHC2024

library
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: src
  exposed-modules:
    Free.Agent.Syntax
    Free.Agent.Layer
    Free.Agent.Pipeline
    Free.Agent.Host
    Free.Agent.Seat
    Free.Agent.Bus
    Free.Agent.CardArchive
    Free.Agent.Diagram
    Free.Agent.Hyper
    Free.Agent.Meeting
    Free.Agent.Derivation
  build-depends:
    aeson >=2.1 && <2.4,
    base >=4.18 && <5,
    bytestring >=0.11 && <0.13,
    circuits >=0.3 && <0.4,
    circuits-agent >=0.1 && <0.2,
    circuits-parser,
    containers >=0.6 && <0.9,
    directory >=1.3 && <1.4,
    filelock >=0.1 && <0.2,
    filepath >=1.4 && <1.6,
    http-client >=0.7 && <0.8,
    http-client-tls >=0.3 && <0.4,
    http-types >=0.12 && <0.13,
    mtl >=2.3 && <2.4,
    process >=1.6 && <1.7,
    stm >=2.5 && <2.6,
    string-diagrams >=0.1 && <0.2,
    text >=2.0 && <3,
    vector,

executable free-agent-axioma
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: app
  main-is: axioma.hs
  build-depends:
    base >=4.18 && <5,
    circuits,
    circuits-agent,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    free-agent,
    mtl >=2.3 && <2.4,
    string-diagrams,
    text >=2.0 && <3,

