cabal-version: 3.0
name: free-agent
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: control
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/free-agent#readme
bug-reports: https://github.com/tonyday567/free-agent/issues
synopsis: Free syntax above circuits-agent (Agent / Shard seats)
description:
  Free constructions above circuits-agent: FreeAgent category and Layer folds,
  inspectable Pipeline stages (Category, route/forName helpers), Host and
  processHost shards (multi-post emit), and FreeSeat composition into
  Shard (StateT [Post] IO) via composeEnds. Package role ABOVE — depends on
  circuits-agent; does not replace Post/Agent/Shard.
build-type: Simple
tested-with:
  ghc ==9.10.1
  ghc ==9.12.2
  ghc ==9.14.1
extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/free-agent

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  if impl(ghc >=9.14)
    ghc-options: -Wno-pattern-namespace-specifier

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Free.Agent.Acp
    Free.Agent.Agent.Runner
    Free.Agent.Bus
    Free.Agent.Bus.Claim
    Free.Agent.Bus.Cli
    Free.Agent.Bus.Daemon
    Free.Agent.Bus.File
    Free.Agent.BusStats
    Free.Agent.Cli
    Free.Agent.Cli.Config
    Free.Agent.Connector
    Free.Agent.Derivation
    Free.Agent.Diagram
    Free.Agent.Gateway
    Free.Agent.Host
    Free.Agent.Hyper
    Free.Agent.Json
    Free.Agent.Layer
    Free.Agent.Meeting
    Free.Agent.Pipeline
    Free.Agent.Seat
    Free.Agent.Syntax

  build-depends:
    base >=4.20 && <5,
    bytestring >=0.11 && <0.13,
    circuits >=0.3 && <0.4,
    circuits-agent >=0.1 && <0.2,
    circuits-diagrams >=0.1 && <0.2,
    circuits-parser >=0.1 && <0.2,
    containers >=0.6 && <0.9,
    directory >=1.3 && <1.4,
    filelock >=0.1 && <0.2,
    filepath >=1.4 && <1.6,
    fsnotify >=0.4 && <0.5,
    http-client >=0.7 && <0.8,
    http-client-tls >=0.3 && <0.4,
    http-types >=0.12 && <0.13,
    optparse-applicative >=0.17 && <0.20,
    process >=1.6 && <1.7,
    regex-tdfa >=1.3 && <1.4,
    scientific >=0.3 && <0.4,
    stm >=2.5 && <2.6,
    text >=1.2 && <3,
    time >=1.9 && <1.15,
    unix >=2.8 && <2.9,
    vector >=0.12 && <0.14,

executable free-agent-axioma
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: axioma.hs
  build-depends:
    async >=2.2 && <2.3,
    base >=4.20 && <5,
    circuits,
    circuits-agent,
    circuits-diagrams,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    free-agent,
    mtl >=2.2.2 && <2.4,
    process >=1.6 && <1.7,
    stm >=2.5 && <2.6,
    text >=1.2 && <3,
    time >=1.9 && <1.15,

executable free-agent
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: free-agent.hs
  build-depends:
    base >=4.20 && <5,
    circuits,
    circuits-agent,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    free-agent,
    optparse-applicative >=0.17 && <0.20,
    text >=1.2 && <3,
    time >=1.9 && <1.15,

executable bus-claim
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: bus-claim.hs
  build-depends:
    base >=4.20 && <5,
    free-agent,
    optparse-applicative >=0.17 && <0.20,
    text >=1.2 && <3,
