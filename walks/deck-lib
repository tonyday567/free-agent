#!/usr/bin/env bash
# deck-lib — batch Emacs helpers for the deck walks. Source after lib.sh.
#
# Every invocation gets a fresh, frameless `emacs -Q -batch`, the committed deck,
# and the walk's scratch root. No runner daemon, configuration, frame or bus root
# is touched. Elisp prints small values; the shell owns the PASS/FAIL tally.

DECK=${DECK:-"$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/free-agent-bus-deck.el"}
EMACS=${EMACS:-emacs}

# deck_eval FORM — evaluate FORM after loading the deck against this walk's ROOT.
# walk-ids is available inside FORM: unique post ids in the current buffer,
# comma-joined in display order. It reads the same line parser RET uses, rather
# than counting headers or continuation lines.
deck_eval() {
  FREE_AGENT_WALK_ROOT="$ROOT" FREE_AGENT_WALK_FA="$FA" \
    "$EMACS" -Q -batch -l "$DECK" \
    --eval '(progn
      (setq free-agent-bus-root (getenv "FREE_AGENT_WALK_ROOT")
            free-agent-bus-executable (getenv "FREE_AGENT_WALK_FA")
            free-agent-bus-name "runner"
            free-agent-bus-auto-refresh-interval 3600.0
            free-agent-bus-status-refresh-interval 3600.0)
      (defun walk-ids ()
        (let (ids)
          (dolist (line (split-string
                         (buffer-substring-no-properties (point-min) (point-max))
                         "\n" t))
            (let ((id (free-agent-bus--id-in-line line)))
              (when (and id (not (member id ids)))
                (setq ids (append ids (list id))))))
          (mapconcat (function number-to-string) ids ","))))' \
    --eval "$1"
}
